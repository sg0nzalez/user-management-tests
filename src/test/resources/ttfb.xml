<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="User Management TTFB Suite" verbose="1" parallel="classes" thread-count="2">
    <parameter name="Environment" value="${env}"/>
    <test name="User Management TTFB tests">
        <groups>
            <run>
                <include name="ttfb"/>
            </run>
        </groups>
        <packages>
            <package name="org.example.usermanagement.tests"/>
        </packages>
    </test>
</suite>
